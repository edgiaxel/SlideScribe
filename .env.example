# SlideScribe Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/slidescribe?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=slidescribe

# Optional: LLM & Transcription Provider keys for future milestones
GEMINI_API_KEY=
GROQ_API_KEY=

# Processing & Transcription Settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_FILE_SIZE_BYTES=104857600

# Gemma / Ollama Inference Settings
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=60
MAX_INPUT_CHARS_PER_PROMPT=12000


